{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "yul1"
  ],
  "buildCommand": "pnpm run build:vercel",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-updates",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/daily-updates/winter",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/gmail-sync",
      "schedule": "*/10 * * * *"
    }
  ]
}
