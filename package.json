{
  "name": "grandview-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && tsx scripts/migration-checksums.ts",
    "db:checksums": "tsx scripts/migration-checksums.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:dev": "tsx src/db/seed.ts --dev-users",
    "create-owner": "tsx scripts/create-owner.ts",
    "build:vercel": "tsx scripts/deploy-db.ts && next build",
    "db:deploy": "tsx scripts/deploy-db.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.12",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "dotenv": "^18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  }
}
