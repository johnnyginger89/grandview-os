# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://postgres@localhost:5432/grandview_dev
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Shared secret for inbound webhooks (YouCanBook.me, website forms)
INBOUND_WEBHOOK_SECRET=replace-me

# Email (Resend). Leave blank in development: messages are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="Grandview Painting <info@grandviewpainting.ca>"

# Development only: set to false to skip mandatory MFA for management roles locally
MFA_ENFORCED=true
