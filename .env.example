# Copy to .env for local development. Never commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables (Production only).

# Postgres. Production: Supabase "Session pooler" connection string (port 5432),
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres@localhost:5432/grandview_dev
# Optional: connections per server instance (default 3 remote, 10 local)
# DB_POOL_MAX=3

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
# Public URL of the app (https in production), e.g. https://os.grandviewpainting.ca
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Optional: extra allowed origins, comma separated (e.g. the *.vercel.app URL while the custom domain is pending)
# BETTER_AUTH_TRUSTED_ORIGINS=https://grandview-os.vercel.app

# One-time first-owner setup at /setup (32+ characters). Remove after the owner account exists.
# SETUP_TOKEN=

# Webhook secrets, one per source (32+ characters each): openssl rand -hex 24
YCBM_WEBHOOK_SECRET=replace-me
FORM_WEBHOOK_SECRET=replace-me

# Email (Resend). Leave blank locally: messages are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="Grandview Painting <info@grandviewpainting.ca>"
# EMAIL_REPLY_TO=info@grandviewpainting.ca

# Local development only (ignored on the live site): skip mandatory two-factor
MFA_ENFORCED=true

# Phone/desktop notifications (Web Push). Optional: without these the app makes a key pair
# once and keeps it in the database. To set them yourself: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@grandviewpainting.ca
